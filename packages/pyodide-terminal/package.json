{
  "name": "@cp949/runo-pyodide-terminal",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/runo-pyodide-repl.git",
    "directory": "packages/pyodide-terminal"
  },
  "homepage": "https://github.com/cp949/runo-pyodide-repl#readme",
  "bugs": {
    "url": "https://github.com/cp949/runo-pyodide-repl/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./internal": {
      "development": "./src/internal.ts",
      "types": "./dist/internal.d.mts",
      "default": "./dist/internal.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "check-dist": "node ../../scripts/check-dist.mjs dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@cp949/runo-pyodide-core": "workspace:*",
    "@cp949/runo-xterm-readline": "workspace:*"
  },
  "peerDependencies": {
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/pyodide-testkit": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@xterm/xterm": "6.0.0",
    "eslint": "10.11.0",
    "jsdom": "30.1.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
